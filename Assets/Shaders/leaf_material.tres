[gd_resource type="ShaderMaterial" format=3 uid="uid://due6mry1h7u62"]

[sub_resource type="Shader" id="1"]
code = "shader_type spatial;

uniform vec4 albedo : source_color;
uniform float wobble_speed = 1.0;
uniform float wobble_amt = 1.0;

void vertex() {
	VERTEX.x += sin(TIME * VERTEX.x * wobble_speed) * wobble_amt;
	VERTEX.y += sin(TIME * VERTEX.y * wobble_speed) * wobble_amt;
	VERTEX.z += sin(TIME * VERTEX.z * wobble_speed) * wobble_amt;
}

void fragment() {
	ALBEDO = albedo.rgb;
}"

[resource]
render_priority = 0
shader = SubResource("1")
shader_parameter/albedo = Color(0.705882, 0.505882, 0.254902, 1)
shader_parameter/wobble_speed = 0.07
shader_parameter/wobble_amt = 0.25
