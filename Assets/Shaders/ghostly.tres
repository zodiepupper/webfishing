[gd_resource type="ShaderMaterial" format=3 uid="uid://bvdjobif0y36v"]

[sub_resource type="Shader" id="1"]
code = "shader_type spatial;
render_mode depth_prepass_alpha, unshaded;

uniform float speed = 0.1;
uniform float base = 0.7;
uniform float flex = 0.3;
uniform float vert = 0.1;
uniform float vert_time = 0.1;
uniform vec4 color : source_color;

void fragment() {
	ALBEDO = color.rgb;
	ALPHA = base + (flex * sin(TIME * speed));
}

void vertex() {
	VERTEX.x += sin(TIME * vert_time * VERTEX.y) * vert;
	VERTEX.y += sin(TIME * vert_time * VERTEX.z) * vert;
	VERTEX.z += sin(TIME * vert_time * VERTEX.x) * vert;
}"

[resource]
render_priority = 0
shader = SubResource("1")
shader_parameter/speed = 2.0
shader_parameter/base = 0.4
shader_parameter/flex = 0.15
shader_parameter/vert = 0.04
shader_parameter/vert_time = 0.1
shader_parameter/color = Color(0.054902, 0.678431, 0.501961, 1)
