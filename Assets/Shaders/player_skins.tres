[gd_resource type="ShaderMaterial" format=3 uid="uid://bu7gc6ghmda4r"]

[ext_resource type="Texture2D" uid="uid://bshmedys03e3g" path="res://Assets/Models/Playermodel/pattern_collie_cat.png" id="1"]

[sub_resource type="Shader" id="1"]
code = "shader_type spatial;

uniform vec4 albedo : source_color = vec4(1.0);
uniform vec4 albedo_secondary : source_color = vec4(1.0);
uniform vec4 albedo_dark : source_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform sampler2D texture_albedo : source_color;

void fragment() {
	vec3 tex = albedo_dark.rgb * texture(texture_albedo, UV).rgb;
	vec3 tex_full = albedo_secondary.rgb * texture(texture_albedo, UV).rgb;
	
	float mix_amt = texture(texture_albedo, UV).r;
	if (mix_amt == 1.0) {
		ALBEDO = mix(albedo.rgb, tex_full, mix_amt);
	} else {
		ALBEDO = mix(albedo.rgb, tex, mix_amt);
	}
	
}"

[resource]
resource_local_to_scene = true
render_priority = 0
shader = SubResource("1")
shader_parameter/albedo = Color(1, 1, 1, 1)
shader_parameter/albedo_secondary = Color(0, 0, 0, 1)
shader_parameter/albedo_dark = Color(0, 0, 0, 1)
shader_parameter/texture_albedo = ExtResource("1")
