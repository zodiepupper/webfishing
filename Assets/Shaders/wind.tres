[gd_resource type="ShaderMaterial" format=3 uid="uid://bfx5gjfbwe35u"]

[sub_resource type="Shader" id="6"]
code = "shader_type spatial;
render_mode depth_draw_opaque;

uniform vec4 color : source_color;
uniform float scroll_amt = 0.0;
uniform float scroll_width = 0.5;
uniform float bar_width = 1.0;

void vertex() { 
	
	float a;
	if (VERTEX.x > scroll_amt - (scroll_width/2.0)) {
		a = scroll_amt - VERTEX.x;
	} else {
		a = VERTEX.x - (scroll_amt - scroll_width);
	}
	
	VERTEX.z = VERTEX.z * clamp(a * bar_width, 0.0, 1.0);
	
}

void fragment() {
	ALBEDO = color.rgb;
}"

[resource]
resource_local_to_scene = true
render_priority = 0
shader = SubResource("6")
shader_parameter/color = Color(1, 0.968627, 0.921569, 1)
shader_parameter/scroll_amt = 0.0
shader_parameter/scroll_width = 3.502
shader_parameter/bar_width = 0.305
