[gd_resource type="ShaderMaterial" format=3 uid="uid://b7btfquhhh8cj"]

[sub_resource type="Shader" id="2"]
code = "shader_type spatial;

uniform sampler2D noise_tex;
uniform vec4 light_color : source_color;
uniform vec4 dark_color : source_color;

uniform float stretch = 1.0;
uniform float scroll_speed = 0.0;
uniform float threshold = 0.3;

void fragment() {
	vec2 scroll;
	scroll.y = (UV.y*stretch) + (TIME * scroll_speed);
	scroll.x = UV.x;
	float noise = texture(noise_tex, scroll).r;
	if (noise > threshold) {
		ALBEDO = dark_color.rgb;
	} else {
		ALBEDO = light_color.rgb;
	}
}"

[sub_resource type="FastNoiseLite" id="4"]

[sub_resource type="NoiseTexture2D" id="5"]
noise = SubResource("4")
seamless = true

