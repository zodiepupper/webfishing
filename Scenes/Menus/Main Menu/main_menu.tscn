script = ExtResource("9")
header = "Lobby Type"
body = "Choose how the lobby operates.
[color=#6a4420]PUBLIC[/color]: Public and visible in the Game Browser for all to join.
[color=#6a4420]UNLISTED[/color]: Public, but not visible in the Game Browser, while still allowing players to join via code and game invites.
[color=#6a4420]PRIVATE[/color]: Private lobby, only players directly invited may join.
[color=#6a4420]OFFLINE[/color]: Start a game alone, with players unable to join you."

